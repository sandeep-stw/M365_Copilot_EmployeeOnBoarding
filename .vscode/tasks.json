{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Teams App",
      "dependsOn": ["Validate prerequisites", "Provision"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Validate prerequisites",
      "type": "teamsfx",
      "command": "debug-check-prerequisites",
      "args": {
        "prerequisites": ["m365Account"]
      }
    },
    {
      "label": "Provision",
      "type": "teamsfx",
      "command": "provision",
      "args": {
        "env": "dev"
      }
    }
  ]
}
